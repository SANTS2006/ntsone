# ---- Database (Neon Postgres) ----
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

# ---- App ----
NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- File storage (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=program-registration

# ---- Email (Brevo) ----
BREVO_API_KEY=
EMAIL_FROM_NAME=NTSOne
EMAIL_FROM_ADDRESS=no-reply@example.com

# ---- Rate limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ---- Database ----
# Most connections one server instance keeps open. Keep (instances x this) under the database plan's connection limit.
DB_POOL_MAX=10

# ---- Backup and recovery (super admin: Backup & Recovery) ----
# Backups are encrypted files kept OUTSIDE the server; the server's own disk is erased on every deploy.
BACKUP_ENABLED=true
# "s3" = Amazon S3, Cloudflare R2, Backblaze B2, MinIO or any S3-compatible bucket. "local" is for development only.
BACKUP_STORAGE=local
# Development only: where local backups go (default: ./.backups, which is not committed).
BACKUP_LOCAL_DIR=
BACKUP_ALLOW_LOCAL_IN_PRODUCTION=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=database-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
# At least 32 random characters, for example: openssl rand -base64 48. Keep a copy somewhere safe and separate:
# without it the backups cannot be opened.
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_LATEST=7
# Hour of day (UTC, 0-23) when the daily backup starts.
BACKUP_SCHEDULE_HOUR_UTC=2
