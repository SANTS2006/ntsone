{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --clean --target node22 --out-dir dist",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:create-super-admin": "tsx src/db/createSuperAdmin.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "test:unit": "vitest run -c vitest.unit.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.5",
    "@fontsource/poppins": "^5.3.0",
    "@neondatabase/serverless": "^0.10.4",
    "argon2": "^0.41.1",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "pdfkit": "^0.15.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "slugify": "^1.6.6",
    "svg-to-pdfkit": "^0.1.8",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.18.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
